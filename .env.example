# Google Analytics Configuration
# Get your GA4 Measurement ID from https://analytics.google.com
# Format: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=G-WK7N5SVNVD

# Main API Base URL
# VITE_MAIN_API_BASE_URL=https://curatorlabapi-production.up.railway.app
VITE_MAIN_API_BASE_URL=http://localhost:3333

# Registration mode: 'waiting_list' (default) shows request-access dialog,
# 'open' replaces waiting-list buttons with a direct sign-up link to app.photoreka.com/auth
# NUXT_PUBLIC_REGISTRATION_MODE=waiting_list


# Main App URL (for external navigation)
VITE_APP_URL=https://app.photoreka.com

# Site URL (for SEO - canonical URLs, Open Graph, sitemap)
# IMPORTANTE: Usa tu dominio de producción aquí
VITE_SITE_URL=https://www.photoreka.com
